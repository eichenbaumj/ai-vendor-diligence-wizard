# Frontend build-time configuration (all optional in mock mode).
# Without VITE_SUPABASE_URL the app runs fully mocked.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=
# Force mock mode even with a backend configured:
# VITE_MOCK=1
# Show the verified-government-email tier card (the server must also enable it):
# VITE_GOV_VERIFY=1
# Turn the beta notice off (banner, verdict pill, report clause, footer stamp,
# About block, "(beta)" page title). Default on.
# VITE_BETA=0
